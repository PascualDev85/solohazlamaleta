---
import type { CompiledAccommodationPick } from '../../../engine/index.ts';
import { campsiteAnchorId } from '../../lib/anchors.ts';
import { facilityLabels } from '../../lib/facilityLabels.ts';
import { formatDate } from '../../lib/formatDate.ts';
import { formatWholePrice } from '../../lib/formatPrice.ts';
import { placeMapLink } from '../../lib/maps.ts';
import SectionIcon from './SectionIcon.astro';

interface Props {
  pick: CompiledAccommodationPick;
  /** The days whose night was spent here (from the route), oldest first. */
  nights?: number[];
}

const { pick, nights = [] } = Astro.props;
const { place, price_paid: paid } = pick;

// Folded: name, what we paid, what it has and one line of opinion. Open: the
// rest (1.12 §9). The id is the target of "Noche → …" on the day card.
const id = campsiteAnchorId(place.place_id);

const price = paid ? formatWholePrice(paid.amount, paid.currency) : undefined;

const facilities = place.facilities ? facilityLabels(place.facilities) : [];
const hasMore = Boolean(place.notes || pick.notes || paid);
---

<li class="camp" id={id}>
  {/* Outside the summary, so tapping a night goes to its day without toggling the card. */}
  {nights.length > 0 && (
    <p class="camp__nights">
      {nights.map((day) => (
        <a class="camp__night" href={`#dia-${day}`}>
          <SectionIcon name="sleep" />Noche {day}
        </a>
      ))}
    </p>
  )}
  <details class="camp__details">
    <summary class="camp__summary">
      <span class="camp__head">
        <span class="camp__name">{place.name}</span>
        {price && (
          <span class="camp__price">
            {price}<span class="camp__price-unit"> / noche</span>
          </span>
        )}
      </span>
      {facilities.length > 0 && (
        <span class="camp__facts">
          {facilities.map((label) => <span class="camp__fact">{label}</span>)}
        </span>
      )}
      {pick.opinion && <span class="camp__opinion">{pick.opinion}</span>}
      {hasMore && <span class="fold-chevron camp__chevron" aria-hidden="true"></span>}
    </summary>

    <div class="camp__more">
      {place.notes && <p>{place.notes}</p>}
      {pick.notes && <p>{pick.notes}</p>}
      {paid && (
        <p class="guide__verified">
          Lo que pagamos en {formatDate(paid.verified_at)}, 2 personas y camper sin electricidad.
        </p>
      )}
      {/* "Mapa" and "Web" read in the context of the card (its list item names the campsite), as WCAG 2.4.4 allows. */}
      <p class="camp__links">
        <a href={placeMapLink(place)} target="_blank" rel="noopener">
          <SectionIcon name="pin" />Mapa<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
        </a>
        {place.source_url && (
          <a href={place.source_url} target="_blank" rel="noopener">
            Web<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
          </a>
        )}
      </p>
    </div>
  </details>
</li>
