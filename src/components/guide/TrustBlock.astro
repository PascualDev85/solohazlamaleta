---
import { formatDate, formatLongDate } from '../../lib/formatDate.ts';

interface Props {
  travelers: string;
  tripDone: string;
  days: number;
  stops: number;
  updatedAt: string;
}

const { travelers, tripDone, days, stops, updatedAt } = Astro.props;
---

<div class="trip-facts">
  <p class="trip-facts__by">Ruta recorrida por {travelers} · {formatDate(tripDone)}</p>
  <p class="trip-facts__about">
    {days} días · {stops} paradas ·{' '}
    <a href="/sobre-mi/">Quién está detrás <span aria-hidden="true">→</span></a>
  </p>
  <p class="trip-facts__updated">
    Actualizado el <time datetime={updatedAt}>{formatLongDate(updatedAt)}</time>
  </p>
</div>
