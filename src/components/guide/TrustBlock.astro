---
import { formatDate } from '../../lib/formatDate.ts';

interface Props {
  tripDone: string;
  travelers?: number;
  days?: number;
  stops: number;
}

const { tripDone, travelers, days, stops } = Astro.props;

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const facts = [
  formatDate(tripDone),
  travelers != null && plural(travelers, 'persona', 'personas'),
  days != null && plural(days, 'día', 'días'),
  plural(stops, 'parada', 'paradas'),
].filter(Boolean);
---

<div class="trust">
  <p class="trust__title">Ruta realizada por nosotros</p>
  <ul class="trust__facts">
    {facts.map((fact) => <li>{fact}</li>)}
  </ul>
  <p class="trust__about"><a href="/sobre-mi/">Quién está detrás</a></p>
</div>
