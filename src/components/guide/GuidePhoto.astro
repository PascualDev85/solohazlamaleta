---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes: string;
  /** The above-the-fold photo: loaded eagerly and first, since it is the LCP element. */
  priority?: boolean;
  class?: string;
}

const { image, alt, sizes, priority = false, class: className } = Astro.props;

// Per-format quality: AVIF at 45 is visually lossless on textured photos and a
// third of the bytes; <Picture> would force one quality on every format.
const widths = [400, 640, 800, 1024].filter((w) => w <= image.width);
const [avif, webp, jpg] = await Promise.all([
  getImage({ src: image, widths, format: 'avif', quality: 45 }),
  getImage({ src: image, widths, format: 'webp', quality: 65 }),
  getImage({ src: image, widths, format: 'jpg', quality: 70 }),
]);
---

<picture>
  <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
  <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
  <img
    src={jpg.src}
    srcset={jpg.srcSet.attribute}
    sizes={sizes}
    width={image.width}
    height={image.height}
    alt={alt}
    class={className}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
  />
</picture>
