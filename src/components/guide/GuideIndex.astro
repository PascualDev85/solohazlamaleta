---
import { dayAnchorId } from '../../lib/anchors.ts';
import { twoDigitDay } from '../../lib/dayNumber.ts';
import SectionIcon from './SectionIcon.astro';

interface Props {
  sections: { id: string; label: string; icon?: string }[];
  routeId?: string;
  days?: { day: number; title: string }[];
  /** The pill and the panel's heading: the hub says "En esta página". */
  title?: string;
}

const { sections, routeId, days = [], title = 'En esta guía' } = Astro.props;
---

{/*
  Native popover: opens, closes, Esc and light-dismiss with no JavaScript.
  The script only closes it once a section is chosen, so it does not cover
  the destination; without it the panel is still closed by hand.

  The only trigger is a pill floating at the bottom of the screen. It starts
  away (data-away) and shows while the reader scrolls up, until the very top
  (rule: nextDock in src/lib/scroll-direction.ts). The script below only flips
  that attribute; the slide is CSS. Render this component as a direct child of
  .guide, outside any transformed block, or the fixed pill would be anchored
  to that block.
*/}
<button class="guide-index__dock" type="button" popovertarget="guide-index" data-away>
  <SectionIcon name="list" />
  {title}
</button>

<div id="guide-index" class="guide-index" popover role="dialog" aria-labelledby="guide-index-title">
  <header class="guide-index__head">
    <h2 id="guide-index-title">{title}</h2>
    <button
      class="guide-index__close"
      type="button"
      popovertarget="guide-index"
      popovertargetaction="hide"
      aria-label="Cerrar"
      autofocus
    >
      <SectionIcon name="close" />
    </button>
  </header>

  <nav aria-labelledby="guide-index-title">
    <ul class="guide-index__sections">
      {sections.map((section) =>
        section.id === routeId && days.length > 0 ? (
          <li>
            <details class="guide-index__group" open>
              <summary class="guide-index__row">
                <span class="guide-index__icon">{section.icon && <SectionIcon name={section.icon} />}</span>
                <span class="guide-index__label">{section.label}</span>
                <span class="guide-index__chevron" aria-hidden="true" />
              </summary>
              <ol class="guide-index__days">
                <li><a href={`#${section.id}`}>Toda la ruta</a></li>
                {days.map((day) => (
                  <li>
                    <a href={`#${dayAnchorId(day.day)}`}>
                      <span class="guide-index__daynum">{twoDigitDay(day.day)}</span>
                      <span>{day.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          </li>
        ) : (
          <li>
            <a class="guide-index__row" href={`#${section.id}`}>
              <span class="guide-index__icon">{section.icon && <SectionIcon name={section.icon} />}</span>
              <span class="guide-index__label">{section.label}</span>
            </a>
          </li>
        ),
      )}
    </ul>
  </nav>
</div>

<script>
  import { nextDock } from '../../lib/scroll-direction.ts';
  import { keepFocusIn } from '../../lib/popover-focus.ts';

  // Close the index once a section is chosen, so it does not cover it.
  const index = document.getElementById('guide-index');

  // Tab stays inside whichever panel is open: this index, the route at a
  // glance and each day's full sheet. Wired here once, so the helper ships
  // inside this script instead of as a chunk of its own.
  for (const panel of document.querySelectorAll<HTMLElement>('[popover][role="dialog"]')) keepFocusIn(panel);
  index?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) index.hidePopover();
  });

  // Show the pill while scrolling up, hide it while scrolling down or at the top.
  const dock = document.querySelector<HTMLElement>('.guide-index__dock');
  if (dock) {
    let state = { anchor: scrollY, visible: false };
    let frame = 0;
    addEventListener(
      'scroll',
      () => {
        if (frame) return; // at most one update per frame
        frame = requestAnimationFrame(() => {
          frame = 0;
          state = nextDock(state, scrollY);
          dock.toggleAttribute('data-away', !state.visible);
        });
      },
      { passive: true },
    );
  }
</script>
