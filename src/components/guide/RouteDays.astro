---
import type { CompiledDay } from '../../../engine/index.ts';
import DayCard from './DayCard.astro';
import SectionIcon from './SectionIcon.astro';

interface Props {
  days: CompiledDay[];
  /** Anchor of the section, shared with the guide index. */
  id: string;
}

const { days, id } = Astro.props;
---

{/*
  The whole route as one swipeable row: every day is a card, the strip of day
  numbers above says how many there are and where you are. Without JavaScript
  it is a plain scroll-snap row and the numbers are anchor links; the script
  only adds smooth jumps, the current day and the desktop arrows.
*/}
<section class="route" aria-labelledby={id}>
  <div class="route__head">
    <h2 id={id}>La ruta <span class="route__count">{days.length} días</span></h2>
    <div class="route__bar">
      <nav class="route__nav" aria-label="Días de la ruta">
        <ol class="route__days">
          {days.map((day) => (
            <li>
              <a href={`#dia-${day.day}`} title={day.title}>
                <span class="visually-hidden">Día </span>{String(day.day).padStart(2, '0')}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="route__arrows" hidden>
        <button class="route__arrow" type="button" data-step="-1" aria-label="Día anterior">
          <SectionIcon name="arrow-left" />
        </button>
        <button class="route__arrow" type="button" data-step="1" aria-label="Día siguiente">
          <SectionIcon name="arrow" />
        </button>
      </div>
    </div>
  </div>

  <div class="route__rail">
    {days.map((day) => <DayCard day={day} />)}
  </div>

  <script is:inline>
    (() => {
      const root = document.currentScript.closest('.route');
      const rail = root.querySelector('.route__rail');
      const strip = root.querySelector('.route__days');
      const links = [...strip.querySelectorAll('a')];
      const cards = [...rail.children];
      const arrows = root.querySelector('.route__arrows');
      const [prev, next] = arrows.querySelectorAll('button');
      const behavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      let current = 0;

      // Offsets are measured from the first card, which sits at the row's start
      // when it is not scrolled: no need to resolve the padding expression.
      const start = (card) => card.offsetLeft - cards[0].offsetLeft;
      const go = (i) => {
        const card = cards[Math.max(0, Math.min(cards.length - 1, i))];
        rail.scrollTo({ left: start(card), behavior });
      };

      const mark = (i) => {
        if (links[current]) links[current].removeAttribute('aria-current');
        current = i;
        links[i].setAttribute('aria-current', 'step');
        const li = links[i].parentElement;
        strip.scrollTo({ left: li.offsetLeft - (strip.clientWidth - li.offsetWidth) / 2, behavior });
        prev.disabled = i === 0;
        next.disabled = i === cards.length - 1;
      };

      links.forEach((link, i) => link.addEventListener('click', (e) => { e.preventDefault(); go(i); }));
      arrows.addEventListener('click', (e) => {
        const button = e.target.closest('button');
        if (button) go(current + Number(button.dataset.step));
      });

      // The current day is the card closest to the row's start. Earlier cards
      // can still show beside the column on wide screens, so visibility alone
      // would not tell.
      let frame = 0;
      rail.addEventListener('scroll', () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          let best = 0;
          cards.forEach((card, i) => {
            if (Math.abs(start(card) - rail.scrollLeft) < Math.abs(start(cards[best]) - rail.scrollLeft)) best = i;
          });
          if (best !== current) mark(best);
        });
      }, { passive: true });

      mark(0);
      arrows.hidden = false;
    })();
  </script>
</section>
