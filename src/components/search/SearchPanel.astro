---
// The search, shared by /buscar/ and the landing page's search window. The
// index is the markup itself: every guide and its places are in the HTML,
// so there is no fetch and nothing for the page's CSP to allow. Without
// JavaScript it is a plain list of links; the script below only shows the
// field and hides what does not match.
import { getImage } from 'astro:assets';
import { guideImage } from '../../lib/guide-images.ts';
import { destinationLabel } from '../../lib/search-index.ts';
import { searchSummary } from '../../lib/search.ts';
import type { SearchGuide } from '../../lib/search.ts';

interface Props {
  guides: SearchGuide[];
  /** Prefix for the ids, so two panels could share a page. */
  id: string;
  /** Heading level of the destination names: 2 on its own page, 3 inside a titled window. */
  level?: 2 | 3;
}

const { guides, id, level = 2 } = Astro.props;
const Destination = `h${level}` as 'h2' | 'h3';
const Guide = `h${level + 1}` as 'h3' | 'h4';

const destinations = new Map<string, SearchGuide[]>();
for (const guide of guides) destinations.set(guide.destination, [...(destinations.get(guide.destination) ?? []), guide]);

const placeCount = guides.reduce((sum, guide) => sum + guide.places.length, 0);

// A small square thumbnail per guide with a cover: two light files, loaded
// only when the result is on screen (a closed window renders nothing).
const thumbs = new Map<string, { avif: string; webp: string }>();
for (const guide of guides) {
  if (!guide.cover) continue;
  const image = guideImage(guide.cover);
  const [avif, webp] = await Promise.all(
    (['avif', 'webp'] as const).map((format) =>
      getImage({ src: image, width: 144, height: 144, fit: 'cover', format, quality: format === 'avif' ? 40 : 65 }),
    ),
  );
  thumbs.set(guide.url, { avif: avif.src, webp: webp.src });
}
---

<div class="search" data-search>
  <div class="search__field" data-search-field hidden>
    <label class="search__label" for={`${id}-input`}>Destino, guía o lugar</label>
    <input
      class="search__input"
      id={`${id}-input`}
      type="search"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
      placeholder="Islandia, Gullfoss, Riquewihr…"
      aria-describedby={`${id}-hint`}
      data-search-input
    />
    <p class="search__hint" id={`${id}-hint`}>Sin tildes también vale: «jokulsarlon», «thingvellir».</p>
  </div>

  <p class="search__status" role="status" aria-live="polite" data-search-status>
    {searchSummary(placeCount, guides.length)}
  </p>

  <div class="search__empty" data-search-empty hidden>
    <p>Sin resultados para «<span data-search-query />».</p>
    <p>
      Prueba con otra palabra o <button class="search__clear" type="button" data-search-clear>borra la búsqueda</button>
      para verlo todo. También puedes ver <a href="/#guias">todas las guías</a>.
    </p>
  </div>

  {[...destinations].map(([destination, destinationGuides]) => (
    <section class="search__destination" data-search-destination>
      <Destination class="search__destination-name">{destinationLabel(destination)}</Destination>
      {destinationGuides.map((guide) => {
        const thumb = thumbs.get(guide.url);
        return (
          <article class="search__guide" data-search-guide data-search-text={guide.text}>
            <a class="search__guide-link" href={guide.url}>
              {thumb ? (
                <picture class="search__thumb">
                  <source type="image/avif" srcset={thumb.avif} />
                  <img src={thumb.webp} alt="" width="72" height="72" loading="lazy" decoding="async" />
                </picture>
              ) : (
                <span class="search__thumb search__thumb--empty" aria-hidden="true">{destinationLabel(destination).charAt(0)}</span>
              )}
              <span class="search__guide-text">
                <Guide class="search__guide-title">{guide.title}</Guide>
                <span class="search__guide-meta">
                  {guide.days} días · {guide.places.length} lugares
                  {guide.draft && <span class="pill pill--draft">Borrador</span>}
                </span>
              </span>
            </a>
            <ul class="search__places">
              {guide.places.map((place) => (
                <li data-search-place data-search-text={place.text}>
                  <a href={place.url}>
                    <span>{place.name}</span>
                    <span class="search__day">Día {place.day}</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        );
      })}
    </section>
  ))}
</div>

<script>
  import { filterSearch, searchSummary } from '../../lib/search.ts';

  // Every search panel on the page, each on its own.
  for (const root of document.querySelectorAll<HTMLElement>('[data-search]')) {
    const field = root.querySelector<HTMLElement>('[data-search-field]')!;
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
    const status = root.querySelector<HTMLElement>('[data-search-status]')!;
    const empty = root.querySelector<HTMLElement>('[data-search-empty]')!;
    const queryEcho = root.querySelector<HTMLElement>('[data-search-query]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-search-clear]')!;
    const sections = [...root.querySelectorAll<HTMLElement>('[data-search-destination]')];
    const guides = [...root.querySelectorAll<HTMLElement>('[data-search-guide]')].map((el) => ({
      el,
      text: el.dataset.searchText ?? '',
      places: [...el.querySelectorAll<HTMLElement>('[data-search-place]')].map((place) => ({
        el: place,
        text: place.dataset.searchText ?? '',
      })),
    }));
    const initialStatus = status.textContent?.trim() ?? '';
    let announce: number | undefined;

    const update = () => {
      const query = input.value.trim();
      const found = filterSearch(guides, query);
      const shownGuides = new Set(found.map((guide) => guide.el));
      const shownPlaces = new Set(found.flatMap((guide) => guide.places.map((place) => place.el)));
      for (const guide of guides) {
        guide.el.hidden = !shownGuides.has(guide.el);
        for (const place of guide.places) place.el.hidden = !shownPlaces.has(place.el);
      }
      for (const section of sections) section.hidden = !section.querySelector('[data-search-guide]:not([hidden])');
      empty.hidden = found.length > 0;
      queryEcho.textContent = query;
      // Announced once typing pauses, not on every key.
      clearTimeout(announce);
      announce = window.setTimeout(() => {
        status.textContent = query ? searchSummary(shownPlaces.size, found.length) : initialStatus;
      }, 400);
    };

    field.hidden = false;
    input.addEventListener('input', update);
    clear.addEventListener('click', () => {
      input.value = '';
      update();
      input.focus();
    });
  }
</script>
