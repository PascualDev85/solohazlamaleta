---
// The landing page's search: a big field under the title that opens a search
// window with results as you type (the pattern of the travel blogs the author
// pointed to). Without JavaScript the field is a link to /buscar/, which
// lists everything. With it, the link opens a native <dialog>: Escape closes
// it and focus goes back to the field, both by the browser.
import SearchPanel from '../search/SearchPanel.astro';
import SectionIcon from '../guide/SectionIcon.astro';
import type { SearchGuide } from '../../lib/search.ts';

interface Props {
  guides: SearchGuide[];
}

const { guides } = Astro.props;
---

<a class="home-search" href="/buscar/" aria-haspopup="dialog" data-search-open>
  <SectionIcon name="pin" />
  <span class="home-search__placeholder">¿A dónde vas? Destino, guía o lugar</span>
  <span class="home-search__go">Buscar</span>
</a>

<dialog class="search-dialog" aria-labelledby="search-dialog-title" closedby="any" data-search-dialog>
  <div class="search-dialog__head">
    <h2 class="search-dialog__title" id="search-dialog-title">Buscar en las guías</h2>
    <form method="dialog">
      <button class="search-dialog__close" type="submit" aria-label="Cerrar la búsqueda">
        <SectionIcon name="close" />
      </button>
    </form>
  </div>
  <SearchPanel guides={guides} id="home-search" level={3} />
</dialog>

<script>
  const opener = document.querySelector<HTMLAnchorElement>('[data-search-open]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');

  if (opener && dialog && typeof dialog.showModal === 'function') {
    const input = dialog.querySelector<HTMLInputElement>('[data-search-input]');
    opener.addEventListener('click', (event) => {
      event.preventDefault();
      dialog.showModal();
      input?.focus();
    });
    // Escape closes the window even with text in the field: a search input
    // would otherwise spend the first Escape clearing itself.
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      event.preventDefault();
      dialog.close();
    });
    // A tap on the backdrop closes it where closedby="any" is not supported yet.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
