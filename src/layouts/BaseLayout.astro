---
import '../styles/main.scss';
import { inlineFits, menuDestinations, pagePathFromFile, siteLinks } from '../lib/site-menu.ts';
import { loadMenuGuides } from '../lib/site-menu-guides.ts';

interface Props {
  title: string;
  description: string;
  /** Keeps a page out of search results: print views, redirects, offers. */
  noindex?: boolean;
  image?: string;
  /** Pixel size and description of `image`, for the Open Graph card. */
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  /** Open Graph type: guides are articles; everything else stays a website. */
  ogType?: 'website' | 'article';
  /** Opt-in to the redesign; scoped so pages without it render unchanged. */
  design?: 'v2';
}

const {
  title,
  description,
  noindex = false,
  image,
  imageWidth,
  imageHeight,
  imageAlt,
  ogType = 'website',
  design,
} = Astro.props;

const preloadFonts =
  design === 'v2'
    ? [
        // Italic is not preloaded: it only appears in folded text ("Lo mejor
        // del día"), so it loads on demand instead of competing with the hero.
        '/fonts/literata-latin-wght.woff2',
        '/fonts/fraunces-latin-700-soft.woff2',
        '/fonts/nunito-latin-var.woff2',
      ]
    : ['/fonts/instrument-serif-latin.woff2'];

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Only pages that exist today; no empty links. "Guías" is the list on the home
// page, so it never marks itself current: that page's own link is the brand.
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const currentFor = (href: string) => (href === pathname ? 'page' : undefined);
const navLinks = [
  { href: '/#guias', label: 'Guías' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
  { href: '/buscar/', label: 'Buscar' },
];
const ogImage = image ? new URL(image, Astro.site).href : undefined;

// One list for the header row and the menu: navLinks, with the published
// destinations under "Guías" (src/lib/site-menu.ts). A link added to navLinks
// shows in both. Phones get the menu button; desktop gets the row while it
// fits, the button otherwise.
const pagePaths = new Set(
  Object.keys(import.meta.glob('../pages/**/*.astro')).flatMap((file) => pagePathFromFile(file) ?? []),
);
const destinations = menuDestinations(await loadMenuGuides(), { currentPath: pathname, pagePaths });
const links = siteLinks(navLinks, destinations);
const rowFits = inlineFits(links);
const signature = 'Nosotros hacemos el trabajo difícil. Tú solo haz la maleta.';
---

<!doctype html>
<html lang="es" data-design={design}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Solo Haz la Maleta" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {ogImage && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <header class="wrap site-header">
      <a href="/" class="brand" aria-current={currentFor('/')}>Solo Haz la Maleta</a>
      <nav class="site-nav" aria-label="Principal" data-menu={rowFits ? undefined : 'always'}>
        <ul>
          {links.flatMap((link) => [link, ...link.children]).map((link) => (
            <li><a href={link.href} aria-current={currentFor(link.href)}>{link.label}</a></li>
          ))}
        </ul>
        {/* Native popover: opens, closes, Esc and a tap outside need no JavaScript. */}
        <button class="site-menu__open" type="button" popovertarget="site-menu" aria-label="Menú">
          <span class="site-menu__bars" aria-hidden="true"></span>
        </button>
      </nav>
      <div id="site-menu" class="site-menu" popover role="dialog" aria-labelledby="site-menu-title">
        <div class="site-menu__head">
          <p id="site-menu-title" class="site-menu__title">Menú</p>
          <button class="site-menu__close" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label="Cerrar" autofocus></button>
        </div>
        <ul class="site-menu__links">
          {links.map((link) => (
            <li>
              <a href={link.href} aria-current={currentFor(link.href)}>{link.label}</a>
              {link.children.length > 0 && (
                <ul>
                  {link.children.map((child) => (
                    <li><a href={child.href} aria-current={currentFor(child.href)}>{child.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
        <p class="site-menu__sign"><strong>Solo Haz la Maleta</strong> {signature}</p>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="wrap site-footer">
      <nav aria-label="Enlaces legales">
        <a href="/sobre-mi/">Sobre mí</a>
        <a href="/afiliacion/">Afiliación</a>
        <a href="/privacidad/">Privacidad</a>
        <a href="/aviso-legal/">Aviso legal</a>
      </nav>
      <p class="site-footer__sign">{signature}</p>
    </footer>

  </body>
</html>
