---
import '../styles/main.scss';

interface Props {
  title: string;
  description: string;
  /** Keeps a page out of search results: print views, redirects, offers. */
  noindex?: boolean;
  image?: string;
  /** Opt-in to the redesign; scoped so pages without it render unchanged. */
  design?: 'v2';
}

const { title, description, noindex = false, image, design } = Astro.props;

const preloadFonts =
  design === 'v2'
    ? [
        // Italic is not preloaded: it only appears in folded text ("Lo mejor
        // del día"), so it loads on demand instead of competing with the hero.
        '/fonts/literata-latin-wght.woff2',
        '/fonts/fraunces-latin-700-soft.woff2',
        '/fonts/nunito-latin-var.woff2',
      ]
    : ['/fonts/instrument-serif-latin.woff2'];

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es" data-design={design}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <header class="wrap site-header">
      <a href="/" class="brand">Solo Haz la Maleta</a>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="wrap site-footer">
      <nav aria-label="Enlaces legales">
        <a href="/sobre-mi/">Sobre mí</a>
        <a href="/afiliacion/">Afiliación</a>
        <a href="/privacidad/">Privacidad</a>
        <a href="/aviso-legal/">Aviso legal</a>
      </nav>
      <p class="site-footer__sign">Nosotros hacemos el trabajo difícil. Tú solo haz la maleta.</p>
    </footer>

  </body>
</html>
