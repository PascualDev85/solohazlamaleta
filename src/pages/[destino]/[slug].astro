---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateNotice from '../../components/AffiliateNotice.astro';
import DraftNotice from '../../components/DraftNotice.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');

  return guides.map((guide) => ({
    params: { destino: guide.data.meta.destination, slug: guide.id },
    props: { guide },
  }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { meta, summary, days, variants, groups } = guide.data;

/** Longest variant first: the default view shows the full itinerary. */
const dayCounts = [...meta.days].sort((a, b) => b - a);

const groupLabels: Record<string, string> = {
  couple: 'En pareja',
  friends: 'Con amigos',
  family_seniors: 'En familia con mayores',
};

const faqJsonLd =
  guide.data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: guide.data.faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : null;
---

<BaseLayout title={meta.title} description={meta.description} noindex={meta.draft}>
  {
    faqJsonLd && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(faqJsonLd)}
        slot="head"
      />
    )
  }

  <article>
    <h1>{meta.title}</h1>

    <p class="dateline">
      {
        meta.tripDone
          ? `Lo hicimos en ${meta.tripDone} · Actualizado ${meta.updatedAt}`
          : `Actualizado ${meta.updatedAt}`
      }
    </p>

    {meta.draft && <DraftNotice />}
    <AffiliateNotice />

    <section class="summary" aria-labelledby="resumen">
      <h2 id="resumen">En resumen</h2>
      <dl>
        <dt>Para quién</dt><dd>{summary.forWho}</dd>
        <dt>Ritmo</dt><dd>{summary.pace}</dd>
        <dt>Mejor época</dt><dd>{summary.bestSeason}</dd>
        <dt>Cómo moverse</dt><dd>{summary.gettingAround}</dd>
        <dt>Base</dt><dd>{summary.baseArea}</dd>
      </dl>
    </section>

    <section aria-labelledby="duraciones">
      <h2 id="duraciones">Cuántos días tienes</h2>
      <p>
        Esta misma ruta sirve para {meta.days.join(', ')} días. Cada versión usa los días
        que se indican abajo.
      </p>
      <ul>
        {
          dayCounts.map((count) => (
            <li>
              <strong>{count} días:</strong> días {variants[String(count)]?.join(', ')}
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="itinerario">
      <h2 id="itinerario">Día a día</h2>

      {
        days.map((day) => (
          <section class="day" aria-labelledby={`dia-${day.day}`}>
            <h3 id={`dia-${day.day}`}>
              Día {day.day}. {day.title}
            </h3>
            <p>{day.summary}</p>

            <p class="effort">
              A pie: {day.physicalLevel.walkingKm} km · Cuestas: {day.physicalLevel.hills}
            </p>

            <ol class="stops">
              {day.stops.map((stop) => (
                <li>
                  <strong>{stop.name}</strong>
                  <span class="meta"> · {stop.durationMin} min</span>
                  {stop.notes && <p class="notes">{stop.notes}</p>}
                </li>
              ))}
            </ol>

            {day.localTip && (
              <p class="tip">
                <strong>Lo que haríamos distinto:</strong> {day.localTip}
              </p>
            )}

            {day.planB && (
              <p class="tip">
                <strong>Plan B:</strong> {day.planB}
              </p>
            )}

            {groups.map((group) =>
              day.groupAdjustments[group] ? (
                <p class="adjust">
                  <strong>{groupLabels[group]}:</strong> {day.groupAdjustments[group]}
                </p>
              ) : null,
            )}
          </section>
        ))
      }
    </section>
  </article>
</BaseLayout>

<style>
  .dateline {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .summary {
    background: var(--color-surface);
    padding: var(--space-md);
    border-radius: var(--radius);
  }

  .summary dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-xs) var(--space-md);
    margin: 0;
  }

  .summary dt {
    font-weight: 700;
  }

  .summary dd {
    margin: 0;
  }

  .day {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
    margin-top: var(--space-lg);
  }

  .effort,
  .meta {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .stops li + li {
    margin-top: var(--space-sm);
  }

  .notes {
    margin: var(--space-xs) 0 0;
  }

  .tip,
  .adjust {
    background: var(--color-surface);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius);
  }

  @media (max-width: 30rem) {
    .summary dl {
      grid-template-columns: 1fr;
    }
  }
</style>
