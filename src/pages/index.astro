---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/v1-components.scss';
import { loadCompiledGuide } from '../lib/engine-guide.ts';
import {
  ENGINE_GUIDE_SOURCES, fromLegacyGuide, fromCompiledGuide, sortGuideList,
} from '../lib/guide-list.ts';

const legacyGuides = await getCollection('guides');
const engineGuides = await Promise.all(
  ENGINE_GUIDE_SOURCES.map((source) => loadCompiledGuide(source.guide, source.places)),
);

/** Published guides first; drafts are listed but clearly marked. */
const sorted = sortGuideList([
  ...legacyGuides.map((guide) => fromLegacyGuide(guide.id, guide.data)),
  ...engineGuides.map(fromCompiledGuide),
]);
---

<BaseLayout
  title="Solo Haz la Maleta — Guías de viaje ya planificadas"
  description="Itinerarios día a día con la ruta lista para Google Maps y qué reservar y cuándo. De viajes hechos, no copiados, y adaptados a cómo viajas."
>
  <section class="hero">
    <h1 class="hero__title">Nosotros hacemos el trabajo difícil.<br /><em>Tú solo haz la maleta.</em></h1>

    <p class="lede">
      Itinerarios día a día, con la ruta lista para abrir en Google Maps y qué hay que
      reservar y cuándo. De viajes hechos, no copiados.
    </p>

    <p>Gratis y completas. Sin pedirte el correo.</p>
  </section>

  <h2 class="section-label" id="guias">Guías</h2>

  {
    sorted.length === 0 ? (
      <p>Todavía no hay guías publicadas.</p>
    ) : (
      <ul class="guide-list" aria-labelledby="guias">
        {sorted.map((guide) => (
          <li>
            <a class="guide-list__item" href={guide.url}>
              <p class="guide-list__meta">
                <span>{guide.destination}</span>
                <span>·</span>
                <span>{guide.days.join(' · ')} días</span>
                {guide.lived && <span class="badge badge--lived">Lo hicimos</span>}
                {guide.draft && <span class="badge badge--adapted">Borrador</span>}
              </p>

              <h3 class="guide-list__title">{guide.title}</h3>
              <p class="guide-list__desc">{guide.description}</p>

              {guide.livedNote && (
                <p class="guide-list__desc">
                  <small>{guide.livedNote}</small>
                </p>
              )}

              <span class="guide-list__go">Ver la guía →</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
