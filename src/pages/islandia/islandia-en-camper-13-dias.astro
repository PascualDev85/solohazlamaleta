---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCompiledGuide } from '../../lib/engine-guide.ts';
import { formatDate, formatLongDate } from '../../lib/formatDate.ts';
import TrustBlock from '../../components/guide/TrustBlock.astro';
import GuideIndex from '../../components/guide/GuideIndex.astro';
import GuidePhoto from '../../components/guide/GuidePhoto.astro';
import QuickFacts from '../../components/guide/QuickFacts.astro';
import Breadcrumb from '../../components/guide/Breadcrumb.astro';
import RouteDays from '../../components/guide/RouteDays.astro';
import CampsiteCard from '../../components/guide/CampsiteCard.astro';
import { budgetRows } from '../../lib/budgetRows.ts';
import { guideImage } from '../../lib/guide-images.ts';
import { getImage } from 'astro:assets';
import '../../styles/guide-v2.scss';

const guide = await loadCompiledGuide(
  'content/guides/islandia/islandia-en-camper-13-dias.yaml',
  'content/places/islandia.yaml',
);

const variant = guide.variants?.[0];

const destinationName = 'Islandia';

// Who travelled this route. No model field for it: the names are only shown on this page.
const travelerNames = 'David y Natalia';

// The tagline has two lines (1.12 §4): the first is shown larger.
const [taglineLead, ...taglineRest] = guide.summary.tagline.split('\n');
const taglineMore = taglineRest.join(' ');

// Stops we skipped with a reason, across the route: "Lo que dejamos fuera" (1.10 §3.6, 1.12 §13).
const skippedStops = (variant?.days ?? []).flatMap((day) =>
  day.skipped_stops.filter((stop) => stop.skip_reason).map((stop) => ({ day: day.day, stop })),
);

const cover = guideImage(guide.cover_image);
// Temporary: the model has no alt for cover_image yet; it belongs with the photo amendment of 1.10 §3.7 (C3.4).
const coverAlt =
  'Cascada de Gljúfrafoss dentro de una grieta cubierta de musgo, con una persona agachada y los brazos abiertos frente al agua';
const ogImage = await getImage({ src: cover, width: 1200, format: 'jpg', quality: 70 });
const coverSizes = '(min-width: 48rem) 55vw, 100vw';

// One source for "does this section render": the index and the sections below
// read the same flags, so the index can never link to a section that is absent.
const show = {
  route: Boolean(variant),
  sleep: (guide.accommodation?.zones.length ?? 0) > 0,
  transport: Boolean(guide.transport),
  budget: Boolean(guide.budget),
  booking: (guide.booking_checklist?.length ?? 0) > 0,
  howWeChoose: (guide.how_we_choose?.length ?? 0) > 0,
  leftOut: (guide.route_decisions?.length ?? 0) > 0 || skippedStops.length > 0,
  pitfalls: (guide.pitfalls?.length ?? 0) > 0 || (guide.terrain_tips?.length ?? 0) > 0,
  practical: Boolean(guide.practical),
  faq: (guide.faq?.length ?? 0) > 0,
};
// "Nuestro criterio" holds three parts (1.12 §13); it shows when any of them has content.
const showCriteria = show.howWeChoose || show.leftOut || show.pitfalls;

const indexSections = [
  { id: 'itinerario', label: 'La ruta', icon: 'route', visible: show.route },
  { id: 'dormir', label: 'Dónde dormir', icon: 'sleep', visible: show.sleep },
  { id: 'llegar', label: 'Cómo llegamos y nos movimos', icon: 'transport', visible: show.transport },
  { id: 'presupuesto', label: 'Presupuesto real', icon: 'budget', visible: show.budget },
  { id: 'reservar', label: 'Qué reservamos y cuándo', icon: 'booking', visible: show.booking },
  { id: 'criterio', label: 'Nuestro criterio', icon: 'criteria', visible: showCriteria },
  { id: 'practico', label: 'Lo práctico', icon: 'practical', visible: show.practical },
  { id: 'faq', label: 'Preguntas frecuentes', icon: 'faq', visible: show.faq },
].filter((section) => section.visible);

/**
 * Spanish decimal format (1.234,56 €), not toFixed's "1234.56" — this is a
 * Spanish-language page. `useGrouping: true` is explicit and required: this
 * Node/ICU build does not group thousands for the "es-ES" locale by default
 * (verified: `Intl.NumberFormat('es-ES').format(4495.21)` gives "4495,21",
 * not "4.495,21", while "de-DE" groups the same number correctly with no
 * extra options).
 */
const currencyFormatter = new Intl.NumberFormat('es-ES', {
  style: 'currency',
  currency: guide.budget?.currency ?? 'EUR',
  useGrouping: true,
});

// Budget table (1.10 §3.5): concept, group total and the derived per-person figure.
const travelers = guide.base_travelers ?? 1;
const budgetTable = guide.budget ? budgetRows(guide.budget.items, travelers) : [];

/** Only the FAQ items the author marked fit for rich results go into the JSON-LD — the visible FAQ section below shows every question regardless. */
const faqForSchema = (guide.faq ?? []).filter((item) => item.schema === true);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: destinationName, item: new URL('/islandia/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: guide.title, item: pageUrl },
  ],
};

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  dateModified: guide.updated_at,
};

const faqJsonLd =
  faqForSchema.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqForSchema.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : null;
---

<BaseLayout title={guide.title} description={guide.description} image={ogImage.src} design="v2" noindex>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleJsonLd)} slot="head" />

  <article class="guide">
    <header class="guide-hero">
      <div class="guide-hero__text">
        <div class="guide-hero__title">
          {/* /islandia/ does not exist yet, so the destination crumb is not a link (1.10 §3.8). */}
          <Breadcrumb crumbs={[{ label: 'Inicio', href: '/' }, { label: destinationName }]} />
          <h1>{guide.title}</h1>
        </div>

        <p class="guide-hero__intro">
          <span class="guide-hero__lead">{taglineLead}</span>
          {taglineMore && <span class="guide-hero__more">{taglineMore}</span>}
        </p>

      </div>

      <div class="guide-hero__media">
        <GuidePhoto
          class="guide-hero__photo"
          image={cover}
          alt={coverAlt}
          sizes={coverSizes}
          priority
          crop={{ media: '(max-width: 47.99rem)', ratio: 1, position: 'bottom' }}
        />
      </div>
    </header>

    <section class="guide-overview" aria-label="Resumen de la guía">
      {guide.has_experience && guide.trip_done && variant ? (
        <TrustBlock travelers={travelerNames} tripDone={guide.trip_done} updatedAt={guide.updated_at} />
      ) : (
        <p class="guide__dateline">Actualizado el {formatLongDate(guide.updated_at)}</p>
      )}

      <QuickFacts
        currency={guide.budget?.currency ?? 'EUR'}
        budgetPerPerson={guide.summary.budget_per_person}
        budgetTotal={guide.budget?.total_reference}
        budgetHref={show.budget ? '#presupuesto' : undefined}
        pace={guide.summary.pace_default}
        vehicle={guide.summary.getting_around}
        baseArea={guide.summary.base_area}
      />
    </section>
    <script is:inline>
      (() => {
        const overview = document.currentScript.previousElementSibling;
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        overview.classList.add('reveal');
        new IntersectionObserver(([e], o) => e.isIntersecting && (overview.classList.add('is-in'), o.disconnect()), { threshold: 0.15 }).observe(overview);
      })();
    </script>

    {/* Outside the overview on purpose: its entrance transform would anchor the fixed pill. */}
    <GuideIndex
      sections={indexSections}
      routeId="itinerario"
      days={variant?.days.map((day) => ({ day: day.day, title: day.title }))}
    />

    {show.route && variant && <RouteDays days={variant.days} id="itinerario" />}

    {show.sleep && guide.accommodation && (
      <section class="sleep" aria-labelledby="dormir">
        <h2 id="dormir">Dónde dormir</h2>
        {guide.accommodation.notes && <p>{guide.accommodation.notes}</p>}
        {guide.accommodation.zones.map((zone) => (
          <div class="sleep__zone">
            <h3>{zone.name}</h3>
            {zone.description && <p class="sleep__zone-desc">{zone.description}</p>}
            {zone.picks.length > 0 && (
              <ul class="sleep__list">
                {zone.picks.map((pick) => <CampsiteCard pick={pick} />)}
              </ul>
            )}
          </div>
        ))}
      </section>
    )}

    {show.transport && guide.transport && (
      <section aria-labelledby="llegar">
        <h2 id="llegar">Cómo llegamos y nos movimos</h2>
        {guide.transport.arrival?.map((arrival) => (
          <>
            <p><strong>Desde {arrival.from_airport}:</strong> {arrival.description}</p>
            {arrival.notes && <p>{arrival.notes}</p>}
          </>
        ))}
        {guide.transport.local?.map((local) => (
          <>
            <p><strong>{local.mode}:</strong> {local.description}</p>
            {local.notes && <p>{local.notes}</p>}
          </>
        ))}
      </section>
    )}

    {show.budget && guide.budget && (
      <section class="budget" aria-labelledby="presupuesto">
        <h2 id="presupuesto">Presupuesto real</h2>
        {/* Every figure here is derived: the per-person one from the group total and base_travelers (1.10 §3.5). */}
        <p class="budget__head">
          <strong class="budget__per-person">{currencyFormatter.format(guide.budget.total_reference / travelers)} por persona</strong>
          <span class="budget__head-rest">
            {currencyFormatter.format(guide.budget.total_reference)} en total · {travelers} {travelers === 1 ? 'persona' : 'personas'}
            {variant && ` · ${variant.days.length} días`}
          </span>
        </p>
        <p class="guide__verified">Precios comprobados {formatDate(guide.budget.verified_at)}</p>
        <table class="budget__table">
          <thead>
            <tr>
              <th scope="col">Concepto</th>
              <th scope="col">Total</th>
              <th scope="col">Por persona</th>
            </tr>
          </thead>
          <tbody>
            {budgetTable.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{currencyFormatter.format(row.total)}</td>
                <td>{currencyFormatter.format(row.per_person)}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">Total</th>
              <td>{currencyFormatter.format(guide.budget.total_reference)}</td>
              <td>{currencyFormatter.format(guide.budget.total_reference / travelers)}</td>
            </tr>
          </tfoot>
        </table>
        {guide.budget.includes.length > 0 && (
          <p><strong>Incluye:</strong> {guide.budget.includes.join(' · ')}</p>
        )}
        {guide.budget.excludes.length > 0 && (
          <p><strong>No incluye:</strong> {guide.budget.excludes.join(' · ')}</p>
        )}
        {guide.budget.notes && <p>{guide.budget.notes}</p>}
      </section>
    )}

    {show.booking && guide.booking_checklist && (
      <section aria-labelledby="reservar">
        <h2 id="reservar">Qué reservamos y cuándo</h2>
        <ul class="guide__checklist">
          {guide.booking_checklist.map((item) => (
            <li>
              <strong>{item.label}</strong> · {item.when}
              {item.notes && <p class="guide__note">{item.notes}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {showCriteria && (
      <section class="criteria" aria-labelledby="criterio">
        <h2 id="criterio">Nuestro criterio</h2>

        {show.howWeChoose && guide.how_we_choose && (
          <div class="criteria__part">
            <h3 id="criterio-como">Cómo elegimos</h3>
            <ul class="criteria__list">
              {guide.how_we_choose.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )}

        {show.leftOut && (
          <div class="criteria__part">
            <h3 id="criterio-fuera">Lo que dejamos fuera</h3>
            <p>
              No todo lo que aparece en una ruta merece entrar en ella. Esto es lo que estaba sobre la mesa,
              lo que dejamos fuera y por qué.
            </p>
            {guide.route_decisions && guide.route_decisions.length > 0 && (
              <ul class="criteria__decisions">
                {guide.route_decisions.map((item) => (
                  <li>
                    <p class="criteria__decision">{item.decision}</p>
                    <p>{item.reason}</p>
                  </li>
                ))}
              </ul>
            )}
            {skippedStops.length > 0 && (
              <ul class="criteria__decisions criteria__decisions--stops" aria-label="Paradas que dejamos fuera">
                {skippedStops.map(({ day, stop }) => (
                  <li>
                    <p class="criteria__decision">
                      {stop.place.short_name ?? stop.place.name}
                      <span class="criteria__day">Día {day}</span>
                    </p>
                    {stop.place.description && <p class="criteria__desc">{stop.place.description}</p>}
                    <p>{stop.skip_reason}</p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )}

        {show.pitfalls && (
          <div class="criteria__part">
            <h3 id="errores">Errores y trampas</h3>
            <ul class="criteria__list">
              {guide.pitfalls?.map((item) => <li>{item}</li>)}
              {guide.terrain_tips?.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        )}
      </section>
    )}

    {show.practical && guide.practical && (
      <section aria-labelledby="practico">
        <h2 id="practico">Lo práctico</h2>
        {guide.practical.documents && guide.practical.documents.length > 0 && (
          <>
            <h3>Documentos</h3>
            <ul>{guide.practical.documents.map((item) => <li>{item}</li>)}</ul>
          </>
        )}
        {guide.practical.plugs && <p><strong>Enchufes:</strong> {guide.practical.plugs}</p>}
        {guide.practical.apps && guide.practical.apps.length > 0 && (
          <>
            <h3>Apps</h3>
            <ul>{guide.practical.apps.map((item) => <li>{item}</li>)}</ul>
          </>
        )}
        {guide.practical.tips && guide.practical.tips.length > 0 && (
          <>
            <h3>Consejos</h3>
            <ul>{guide.practical.tips.map((item) => <li>{item}</li>)}</ul>
          </>
        )}
      </section>
    )}

    {show.faq && guide.faq && (
      <section aria-labelledby="faq">
        <h2 id="faq">Preguntas frecuentes</h2>
        <dl class="guide__faq">
          {guide.faq.map((item) => (
            <>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </>
          ))}
        </dl>
      </section>
    )}

    {/* After the visible FAQ on purpose: compression reuses the same text, so the schema costs almost nothing. */}
    {faqJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />}
  </article>
</BaseLayout>
