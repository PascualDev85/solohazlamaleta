---
import affiliates from '../../data/affiliates.json';
import { affiliateRoutes } from '../../lib/affiliate-routes.ts';

/**
 * Every affiliate link leaves the site through here, so the real URLs live in
 * one registry instead of being scattered across guides. Changing a partner
 * means editing affiliates.json, not every page that links to it.
 *
 * The id is `<partner>-<key>`, matching the `affiliate` references in guides
 * (see affiliateRoutes, tested in tests/lib/affiliate-routes.test.ts).
 */
export function getStaticPaths() {
  return affiliateRoutes(affiliates);
}

interface Props {
  url: string;
  partnerName: string;
}

const { url, partnerName } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${url}`} />
    <title>Redirigiendo a {partnerName}</title>
  </head>
  <body>
    <p>
      Te llevamos a {partnerName}. Si no ocurre nada,
      <a href={url} rel="sponsored nofollow noopener">continúa aquí</a>.
    </p>
  </body>
</html>
